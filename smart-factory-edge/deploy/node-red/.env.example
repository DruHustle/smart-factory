# Copy to .env on the Pi, protect with mode 0600, and replace all placeholders.
# Review the official Node-RED image digest for the Pi's actual architecture.
NODE_RED_IMAGE=CHANGE_ME_REVIEWED_NODE_RED_IMAGE_AT_DIGEST
TZ=UTC
NODE_RED_CREDENTIAL_SECRET=CHANGE_ME_RANDOM_32_PLUS_CHARACTER_SECRET
NODE_RED_ADMIN_USER=smartfactory-admin
# Generate with: node-red admin hash-pw
NODE_RED_ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
