# Node-RED is bound to loopback. Use SSH port forwarding or a reviewed private
# reverse proxy for editor access; do not expose port 1880 to the internet.
NODE_RED_IMAGE=nodered/node-red:5.0.9-24
NODE_RED_HOST_PORT=1880
TZ=UTC

NODE_RED_CREDENTIAL_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NODE_RED_ADMIN_USER=smartfactory-admin
# Generate with: node-red admin hash-pw
NODE_RED_ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH

# The existing edge broker remains authoritative for transport policy.
SMART_FACTORY_LOCAL_MQTT_HOST=host.docker.internal
SMART_FACTORY_LOCAL_MQTT_PORT=1883
