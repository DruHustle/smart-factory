# Smart Factory singleton worker template. Copy to .env.prod.worker for a new installation.
# Preserve installed credentials and data paths during migration.
# RENDER_SERVICE_ROLE is an application contract, not a hosting selection.
RENDER_SERVICE_ROLE=worker
ASPNETCORE_ENVIRONMENT=Production
DASHBOARD_API_ORIGIN=https://factory-api.onesa.eu

DATABASE_URL=postgresql://<dashboard-user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_CA_CERT=<aiven-ca-pem-with-escaped-newlines>
TELEMETRY_DATABASE_CONNECTION=Host=<host>;Port=<port>;Database=<telemetry-database>;Username=<user>;Password=<password>;SSL Mode=VerifyFull;Root Certificate=/run/secrets/aiven-ca.pem
INGESTION_API_TOKEN=<same-value-as-api-service>
DASHBOARD_SERVICE_TOKEN=<same-value-as-api-service>
# Same canonical public frontend origin as the API; HTTPS with no path/query.
# ALLOWED_ORIGIN is accepted as the existing single-origin fallback.
PASSWORD_RESET_ORIGIN=https://factory.onesa.eu

# Intended cutover destination; verify DNS and TLS before reconnecting clients.
# Preserve installed credentials/client IDs; never start a second ingestion worker.
MqttBrokerHost=factory-mqtt.onesa.eu
MqttBrokerPort=8883
MqttUsername=<subscriber-user>
MqttPassword=<subscriber-password>
MqttUseTls=true
MqttClientId=smart-factory-production-worker-01
MqttTopic=factory/+/+/+/telemetry
MqttHeartbeatTopic=factory/+/+/+/heartbeat

EMAIL_PROVIDER=resend

RESEND_API_KEY=<key>
RESEND_FROM=Smart Factory <notifications-factory@onesa.eu>
RESEND_ALLOWED_RECIPIENT_DOMAINS=onesa.eu
