# Copy to .env, keep mode 0600, and replace every CHANGE_ME value.
ACTIVEPIECES_IMAGE=CHANGE_ME_REVIEWED_IMMUTABLE_IMAGE_TAG_OR_DIGEST
ACTIVEPIECES_HOST_PORT=8080

AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_USERNAME=activepieces
AP_POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
AP_REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD

# Preserve these across upgrades and backups. Losing AP_ENCRYPTION_KEY makes
# stored Activepieces connections unreadable.
AP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_OR_EQUIVALENT
AP_JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET

# Put a reviewed reverse proxy/TLS origin in front of the loopback listener.
AP_FRONTEND_URL=https://automation.factory.onesa.eu
# Generate with the Activepieces worker CLI using AP_JWT_SECRET. Keep private.
AP_WORKER_TOKEN=CHANGE_ME_REVIEWED_ACTIVEPIECES_WORKER_TOKEN
